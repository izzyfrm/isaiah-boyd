{
  // IMPORTANT: "name" must match the name of your existing Worker in the Cloudflare dashboard.
  "name": "isaiah-boyd",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": ".",
    "binding": "ASSETS",
    // Only these paths run the Worker. Every other URL is served straight from the static files.
    "run_worker_first": ["/api/*", "/sauce", "/sauce/*"]
  },
  // The blog database. Created automatically on first deploy if it doesn't exist.
  "d1_databases": [{ "binding": "DB", "database_name": "sauce" }]
}
